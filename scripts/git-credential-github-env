#!/usr/bin/env bash
# git credential helper: answers github.com credential requests with the token
# found in GITHUB_TOKEN (or GH_TOKEN). The token is read from the environment on
# every call and never persisted.
#
# Wired by docker-entrypoint.sh via:
#   git config --global credential.https://github.com.helper /usr/local/bin/git-credential-github-env
set -euo pipefail

[[ "${1:-}" == "get" ]] || exit 0

token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
[[ -n "${token}" ]] || exit 0

# Consume the request on stdin (protocol/host/path lines) without acting on it.
while IFS= read -r line; do
  [[ -z "${line}" ]] && break
done

# Any username works with a personal access token; x-access-token is what
# GitHub documents for token auth.
printf 'username=x-access-token\npassword=%s\n' "${token}"
