#!/usr/bin/env bash
# git credential helper: answers github.com credential requests with the token
# stored by docker-entrypoint.sh in $XDG_CONFIG_HOME/workstation/secrets/github_token
# (mode 0600). Falls back to GITHUB_TOKEN / GH_TOKEN if they happen to be set.
#
# Wired by docker-entrypoint.sh via:
#   git config --global credential.https://github.com.helper /usr/local/bin/git-credential-github-file
set -euo pipefail

[[ "${1:-}" == "get" ]] || exit 0

token_file="${XDG_CONFIG_HOME:-${HOME}/.config}/workstation/secrets/github_token"
token="${GITHUB_TOKEN:-${GH_TOKEN:-}}"
if [[ -z "${token}" && -r "${token_file}" ]]; then
  token="$(<"${token_file}")"
fi
[[ -n "${token}" ]] || exit 0

# Consume the request on stdin (protocol/host/path lines) without acting on it.
while IFS= read -r line; do
  [[ -z "${line}" ]] && break
done

# Any username works with a personal access token; x-access-token is what
# GitHub documents for token auth.
printf 'username=x-access-token\npassword=%s\n' "${token}"
